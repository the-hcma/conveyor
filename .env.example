# Conveyor service configuration. Copy to .env for local dev; the systemd units
# on the host inject the same variables. NEVER commit a filled-in .env.

# Core Django
CONVEYOR_DEBUG=1
CONVEYOR_SECRET_KEY=change-me-for-any-non-debug-use
CONVEYOR_ALLOWED_HOSTS=localhost,127.0.0.1
CONVEYOR_CSRF_TRUSTED_ORIGINS=

# Database (defaults to a local sqlite file when unset)
# DATABASE_URL=postgres://conveyor:conveyor@localhost:5432/conveyor

# GitHub App webhook (M2)
CONVEYOR_WEBHOOK_SECRET=

# Hot-tier retention window before a delivery ages out to Redpanda (M2)
CONVEYOR_HOT_WINDOW=14d

# Redpanda / Kafka (M3)
CONVEYOR_KAFKA_BOOTSTRAP=
