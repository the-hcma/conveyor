#!/usr/bin/env bash
# .github/ci/ gate — the-hcma/repository-helpers convention; run by pre-pr-checks
# and ci.yml. One venv for ruff + pyright + Django's own system checks.
# assert-uv-lock-version runs before setup-python's `uv sync` (sync can rewrite
# uv.lock from pyproject and hide drift).
set -euo pipefail

bash .github/ci/assert-uv-lock-version
bash .github/ci/setup-python

uv run ruff check src tests
uv run ruff format --check src tests
uv run pyright
CONVEYOR_DEBUG=1 uv run python manage.py check --fail-level WARNING
